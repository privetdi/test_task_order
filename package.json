{
  "name": "orders-aggregator",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "migrate": "node --env-file=.env --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
